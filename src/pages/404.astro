---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { ROUTES } from '../lib/constants';
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be found on Shagun Mehendi Artist Kota."
>
  <div class="container not-found-container section">
    <div class="not-found-card">
      <span class="error-badge">404</span>
      <h1 class="error-heading">Page not found</h1>
      <p class="error-body">
        The page you're looking for doesn't exist. Head back home or message on WhatsApp.
      </p>
      <div class="error-actions">
        <a href={ROUTES.home} class="btn-outline">
          Go to Home
        </a>
        <WhatsAppButton context="general" label="Book" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
  }

  .not-found-card {
    text-align: center;
    max-width: 540px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl) var(--space-md);
  }

  .error-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .error-heading {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .error-body {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-muted);
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
</style>

