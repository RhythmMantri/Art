---
import '../styles/global.css';
import { buildMeta } from '../lib/seo';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContactWidget from '../components/FloatingContactWidget.astro';
import BottomNav from '../components/BottomNav.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const pathname = Astro.url.pathname;
const meta = buildMeta({ title, description, pathname, ogImage });
const fullTitle = `${title} | Shagun`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={meta.ogDescription} />
    <link rel="canonical" href={meta.canonical} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={meta.ogUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:image" content={meta.ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image" content={meta.ogImage} />

    <!-- Google Fonts: Playfair Display + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingContactWidget />
    <BottomNav />
  </body>
</html>

