---
import Nav from './Nav.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { ROUTES } from '../lib/constants';
import { site } from '../config/site';
import { getPhoneLink } from '../lib/deeplink';

const phoneLink = getPhoneLink();

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(path);
};

const navItems = [
  { href: ROUTES.home, label: 'Home' },
  { href: ROUTES.services, label: 'Services & Rates' },
  { href: ROUTES.bridal, label: 'Bridal Artistry' },
  { href: ROUTES.gallery, label: 'Gallery' },
  { href: ROUTES.about, label: 'About Shagun' },
  { href: ROUTES.contact, label: 'Contact' },
];
---

<header class="site-header">
  <div class="container header-container">
    <div class="logo-area">
      <a href={ROUTES.home} class="brand-logo" aria-label="Shagun Mehendi Home">
        <img
          src="/logo.jpg"
          alt="Shagun Mehendi luxury gold emblem"
          class="brand-emblem"
          width="40"
          height="40"
        />
        <span class="brand-name">SHAGUN</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="desktop-nav-wrap">
      <Nav class="header-nav" />
    </div>
  </div>
</header>

<!-- Mobile Drawer Backdrop -->
<div id="mobile-nav-backdrop" class="mobile-nav-backdrop" aria-hidden="true"></div>

<!-- Mobile Slide-out Drawer -->
<div
  id="mobile-nav-drawer"
  class="mobile-nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Site Navigation"
  inert
>
  <div class="drawer-header">
    <a href={ROUTES.home} class="brand-logo" aria-label="Shagun Mehendi Home">
      <img
        src="/logo.jpg"
        alt="Shagun Mehendi luxury gold emblem"
        class="brand-emblem"
        width="36"
        height="36"
      />
      <span class="brand-name">SHAGUN</span>
    </a>
    <button
      id="mobile-menu-close"
      class="drawer-close-btn"
      type="button"
      aria-label="Close navigation menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="drawer-body">
    <nav class="drawer-nav" aria-label="Mobile Navigation Links">
      <ul class="drawer-nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['drawer-nav-link', { 'drawer-nav-link--active': isCurrent(item.href) }]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="drawer-contact-block">
      <p class="drawer-contact-title">Direct Enquiries</p>
      <a href={phoneLink} class="drawer-phone-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Call</span>
      </a>
      <WhatsAppButton context="general" label="Book" class="drawer-wa-btn" />
    </div>
  </div>
</div>

<script>
  function setupMobileNav() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const bottomNavTrigger = document.getElementById('bottom-nav-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-nav-drawer');
    const backdrop = document.getElementById('mobile-nav-backdrop');

    if (!drawer || !backdrop) return;

    function openDrawer() {
      drawer.classList.add('is-open');
      backdrop.classList.add('is-open');
      drawer.removeAttribute('inert');
      trigger?.setAttribute('aria-expanded', 'true');
      bottomNavTrigger?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      drawer.setAttribute('inert', '');
      trigger?.setAttribute('aria-expanded', 'false');
      bottomNavTrigger?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      (bottomNavTrigger || trigger)?.focus();
    }

    trigger?.addEventListener('click', openDrawer);
    bottomNavTrigger?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });
  }

  setupMobileNav();
  document.addEventListener('astro:page-load', setupMobileNav);
</script>

<style>
  .site-header {
    background-color: rgba(255, 255, 255, 0.98);
    border-bottom: 1px solid var(--color-border-light);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-xs);
    padding-bottom: var(--space-xs);
    gap: var(--space-sm);
    min-height: 60px;
  }

  .logo-area {
    display: flex;
    align-items: center;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    text-decoration: none;
  }

  .brand-emblem {
    width: 38px;
    height: 38px;
    object-fit: cover;
    border-radius: var(--radius-full);
    display: block;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-text);
    text-transform: uppercase;
    line-height: 1;
  }

  /* Mobile-first base: Desktop nav is hidden on mobile */
  .desktop-nav-wrap {
    display: none !important;
  }

  /* Progressive enhancement: Desktop layout */
  @media (min-width: 768px) {
    .header-container {
      justify-content: space-between;
      min-height: 64px;
    }

    .desktop-nav-wrap {
      display: flex !important;
      align-items: center;
    }
  }

  /* Mobile Drawer Backdrop */
  .mobile-nav-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    background-color: rgba(28, 27, 26, 0.5);
    backdrop-filter: blur(3px);
    z-index: 1000;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .mobile-nav-backdrop.is-open {
    display: block;
    opacity: 1;
  }

  /* Mobile Drawer Dialog */
  .mobile-nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(85vw, 360px);
    height: 100vh;
    height: 100dvh;
    background-color: var(--color-bg);
    z-index: 1001;
    display: flex;
    flex-direction: column;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.18);
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .mobile-nav-drawer.is-open {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xs) var(--space-sm);
    min-height: 64px;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .drawer-close-btn {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .drawer-close-btn:hover {
    background-color: var(--color-surface);
    border-color: var(--color-primary);
  }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .drawer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .drawer-nav-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: var(--space-xs) var(--space-xs);
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border-light);
    text-decoration: none;
    transition: color var(--transition-fast), padding-left var(--transition-fast);
  }

  .drawer-nav-link:hover {
    color: var(--color-primary);
    padding-left: var(--space-sm);
  }

  .drawer-nav-link--active {
    color: var(--color-primary);
    font-weight: 600;
    border-left: 3px solid var(--color-primary);
    padding-left: var(--space-sm);
    background-color: var(--color-primary-light);
  }

  .drawer-contact-block {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .drawer-contact-title {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .drawer-phone-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .drawer-phone-btn:hover {
    background-color: var(--color-surface);
  }

  .drawer-wa-btn {
    width: 100%;
    min-height: 44px;
  }

  /* Progressive enhancement: Reveal desktop nav on larger screens */
  @media (min-width: 901px) {
    .desktop-nav-wrap {
      display: flex !important;
      align-items: center;
    }

    .header-actions--mobile {
      display: none !important;
    }
  }
</style>
