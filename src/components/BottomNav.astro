---
import { ROUTES } from '../lib/constants';
import { buildWhatsAppLink, getPhoneLink } from '../lib/deeplink';
import { site } from '../config/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isHome = currentPath === '/';
const isGallery = currentPath.startsWith('/gallery');
const isBridal = currentPath.startsWith('/bridal');
const isContact = currentPath.startsWith('/contact');

const phoneLink = getPhoneLink();
const waLink = buildWhatsAppLink('general');
const mapLink = site.gbpUrl || 'https://maps.google.com/?q=Kota,+Rajasthan';
const igLink = site.instagram && !site.instagram.includes('dummy')
  ? `https://instagram.com/${site.instagram}`
  : 'https://instagram.com/';
---

<!-- Contact Popover Backdrop (Closes sheet when tapped outside) -->
<div id="contact-popover-backdrop" class="contact-popover-backdrop" aria-hidden="true"></div>

<!-- Contact Options Popover Sheet -->
<div
  id="contact-popover-sheet"
  class="contact-popover-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="Direct Contact Options"
>
  <div class="popover-header">
    <span class="popover-title">Contact Shagun</span>
    <button
      type="button"
      id="contact-popover-close"
      class="popover-close-btn"
      aria-label="Close contact options"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="popover-options-grid">
    <!-- 1. Direct Phone Call -->
    <a href={phoneLink} class="popover-option popover-option--call">
      <div class="option-icon-wrap option-icon--call" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </div>
      <div class="option-text">
        <span class="option-label">Direct Phone Call</span>
        <span class="option-sub">Call for urgent dates & queries</span>
      </div>
    </a>

    <!-- 2. WhatsApp Enquiry -->
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="popover-option popover-option--wa"
    >
      <div class="option-icon-wrap option-icon--wa" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </div>
      <div class="option-text">
        <span class="option-label">WhatsApp Chat</span>
        <span class="option-sub">Share designs & check dates</span>
      </div>
    </a>

    <!-- 3. Kota Location / Map -->
    <a
      href={mapLink}
      target="_blank"
      rel="noopener noreferrer"
      class="popover-option popover-option--map"
    >
      <div class="option-icon-wrap option-icon--map" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </div>
      <div class="option-text">
        <span class="option-label">Kota, Rajasthan</span>
        <span class="option-sub">View location on Google Maps</span>
      </div>
    </a>

    <!-- 4. Instagram Profile -->
    <a
      href={igLink}
      target="_blank"
      rel="noopener noreferrer"
      class="popover-option popover-option--ig"
    >
      <div class="option-icon-wrap option-icon--ig" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </div>
      <div class="option-text">
        <span class="option-label">Instagram Portfolio</span>
        <span class="option-sub">Browse real bridal photos</span>
      </div>
    </a>
  </div>
</div>

<!-- Floating Bottom Navigation Dock -->
<nav class="bottom-nav-dock" aria-label="Mobile Quick Navigation">
  <div class="dock-container">
    <!-- 1. Home -->
    <a
      href={ROUTES.home}
      class:list={['dock-item', { 'dock-item--active': isHome }]}
      aria-current={isHome ? 'page' : undefined}
    >
      <div class="dock-icon-wrap" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </div>
      <span class="dock-label">Home</span>
    </a>

    <!-- 2. Gallery -->
    <a
      href={ROUTES.gallery}
      class:list={['dock-item', { 'dock-item--active': isGallery }]}
      aria-current={isGallery ? 'page' : undefined}
    >
      <div class="dock-icon-wrap" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
      </div>
      <span class="dock-label">Gallery</span>
    </a>

    <!-- 3. Bridal -->
    <a
      href={ROUTES.bridal}
      class:list={['dock-item', { 'dock-item--active': isBridal }]}
      aria-current={isBridal ? 'page' : undefined}
    >
      <div class="dock-icon-wrap" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14v2H5v-2z"></path>
        </svg>
      </div>
      <span class="dock-label">Bridal</span>
    </a>

    <!-- 4. Contact (Opens Options Popup) -->
    <button
      type="button"
      id="bottom-nav-contact-btn"
      class:list={['dock-item', 'dock-item--contact', { 'dock-item--active': isContact }]}
      aria-expanded="false"
      aria-controls="contact-popover-sheet"
      aria-label="Open contact and enquiry options"
    >
      <div class="dock-icon-wrap" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <span class="dock-label">Contact</span>
    </button>

    <!-- 5. Menu (Opens Drawer) -->
    <button
      type="button"
      id="bottom-nav-menu-btn"
      class="dock-item dock-item--button"
      aria-label="Open navigation menu"
    >
      <div class="dock-icon-wrap" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </div>
      <span class="dock-label">Menu</span>
    </button>
  </div>
</nav>

<script>
  function setupContactPopover() {
    const contactBtn = document.getElementById('bottom-nav-contact-btn');
    const popover = document.getElementById('contact-popover-sheet');
    const backdrop = document.getElementById('contact-popover-backdrop');
    const closeBtn = document.getElementById('contact-popover-close');

    if (!contactBtn || !popover || !backdrop) return;

    function openPopover() {
      popover.classList.add('is-open');
      backdrop.classList.add('is-open');
      contactBtn.classList.add('dock-item--open');
      contactBtn.setAttribute('aria-expanded', 'true');
    }

    function closePopover() {
      popover.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      contactBtn.classList.remove('dock-item--open');
      contactBtn.setAttribute('aria-expanded', 'false');
    }

    contactBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (popover.classList.contains('is-open')) {
        closePopover();
      } else {
        openPopover();
      }
    });

    closeBtn?.addEventListener('click', closePopover);
    backdrop.addEventListener('click', closePopover);

    popover.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closePopover);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && popover.classList.contains('is-open')) {
        closePopover();
      }
    });
  }

  setupContactPopover();
  document.addEventListener('astro:page-load', setupContactPopover);
</script>

<style>
  /* Backdrop */
  .contact-popover-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 94;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .contact-popover-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Popover Sheet (Slides up right above dock) */
  .contact-popover-sheet {
    position: fixed;
    bottom: calc(76px + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%) translateY(12px) scale(0.96);
    width: calc(100% - 28px);
    max-width: 380px;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid var(--color-border);
    border-radius: 22px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16), 0 2px 10px rgba(184, 134, 11, 0.12);
    padding: 14px 16px;
    z-index: 96;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.25s ease;
  }

  .contact-popover-sheet.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border-light, #eee);
  }

  .popover-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .popover-close-btn {
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .popover-close-btn:hover {
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .popover-options-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .popover-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 14px;
    text-decoration: none;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .popover-option:hover,
  .popover-option:active {
    background-color: var(--color-pill-bg, #FFF9F2);
    border-color: var(--color-primary);
    transform: translateX(3px);
  }

  .option-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .option-icon--call {
    background: #00D87E;
  }

  .option-icon--wa {
    background: #25D366;
  }

  .option-icon--map {
    background: #2E9E64;
  }

  .option-icon--ig {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
  }

  .option-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .option-label {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.25;
  }

  .option-sub {
    font-family: var(--font-body);
    font-size: 0.76rem;
    color: var(--color-muted);
    line-height: 1.2;
    margin-top: 1px;
  }

  /* Dock Base */
  .bottom-nav-dock {
    position: fixed;
    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 24px);
    max-width: 420px;
    z-index: 95;
    pointer-events: none;
  }

  .dock-container {
    pointer-events: auto;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(184, 134, 11, 0.22);
    border-radius: 26px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(184, 134, 11, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 6px 6px;
    width: 100%;
  }

  .dock-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--color-muted);
    padding: 6px 2px;
    border-radius: 18px;
    min-height: 48px;
    border: none;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast);
  }

  .dock-item:active {
    transform: scale(0.92);
  }

  .dock-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
  }

  .dock-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.1;
  }

  /* Active Navigation Item (Pill style) */
  .dock-item--active,
  .dock-item--open {
    color: var(--color-primary);
    background-color: var(--color-pill-bg, #FFF9F2);
    box-shadow: 0 2px 8px rgba(184, 134, 11, 0.12);
  }

  .dock-item--active .dock-label,
  .dock-item--open .dock-label {
    font-weight: 700;
  }

  /* Contact item */
  .dock-item--contact {
    color: var(--color-primary);
  }

  /* Menu button reset */
  .dock-item--button {
    font-family: inherit;
  }

  /* Hidden on Desktop screens (> 768px) */
  @media (min-width: 768px) {
    .bottom-nav-dock,
    .contact-popover-sheet,
    .contact-popover-backdrop {
      display: none !important;
    }
  }
</style>
