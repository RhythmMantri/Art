---
import { buildWhatsAppLink, type MessageContext } from '../lib/deeplink';

interface Props {
  context?: MessageContext;
  label?: string;
  variant?: 'gold' | 'outline';
  class?: string;
}

const {
  context = 'general',
  label = 'Book',
  variant = 'gold',
  class: className = '',
} = Astro.props;

const href = buildWhatsAppLink(context);
const btnClass = variant === 'outline' ? 'btn-outline' : 'btn-gold';
---

<a
  href={href}
  class={`${btnClass} ${className}`.trim()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${label} (opens WhatsApp in a new tab)`}
>
  <svg
    class="wa-icon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.59 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67ZM9.15 7.02C8.98 7.02 8.7 7.08 8.46 7.34C8.22 7.6 7.55 8.23 7.55 9.51C7.55 10.79 8.48 12.02 8.61 12.19C8.74 12.36 10.4 15.06 13.01 16.08C15.17 16.93 15.62 16.77 16.08 16.73C16.54 16.69 17.56 16.12 17.77 15.53C17.98 14.94 17.98 14.44 17.92 14.33C17.85 14.23 17.68 14.17 17.43 14.04C17.18 13.91 15.96 13.31 15.73 13.23C15.5 13.14 15.34 13.1 15.17 13.36C15.01 13.61 14.54 14.17 14.39 14.33C14.25 14.5 14.11 14.52 13.86 14.39C13.61 14.27 12.81 14.01 11.86 13.16C11.12 12.5 10.62 11.69 10.48 11.44C10.33 11.19 10.46 11.05 10.59 10.93C10.7 10.82 10.84 10.63 10.97 10.49C11.09 10.34 11.13 10.23 11.22 10.06C11.3 9.89 11.26 9.75 11.2 9.62C11.13 9.5 10.62 8.24 10.41 7.73C10.2 7.23 10 7.3 9.84 7.29C9.69 7.28 9.52 7.28 9.35 7.28L9.15 7.02Z"
    ></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  .wa-icon {
    flex-shrink: 0;
  }
</style>

